{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "ask",
    "bash": {
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git add *": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "ls *": "allow",
      "find *": "allow",
      "*": "ask"
    }
  },
  "agent": {
    "research-assistant": {
      "mode": "primary",
      "color": "#9B59B6",
      "description": "🔍 Research diary manager — creates, formats, reviews notes; tracks contributions; suggests knowledge; proposes folders",
      "permission": {
        "edit": "ask",
        "bash": {
          "git *": "ask",
          "ls *": "allow",
          "find *": "allow",
          "*": "ask"
        }
      }
    },
    "build": {
      "color": "#27AE60",
      "description": "🔨 Build and edit files — write, test, and implement code"
    },
    "plan": {
      "color": "#E74C3C",
      "description": "✏️ Plan — think, research, and outline before making changes"
    }
  }
}
